  User: root
  Default Db: default_cluster:tpch_1g_db
  Sql Statement: EXPLAIN ANALYZE VERBOSE SELECT
\tp_brand,
\tp_type,
\tp_size,
\tcount(distinct ps_suppkey) as supplier_cnt
from
\tPARTSUPP,
\tPART
where
\tp_partkey = ps_partkey
\tand p_brand <> 'Brand#11'
\tand p_type not like 'STANDARD BRUSHED%'
\tand p_size in (11, 14, 5, 40, 41, 30, 32, 19)
\tand ps_suppkey not in (
\t\tselect
\t\t\ts_suppkey
\t\tfrom
\t\t\tSUPPLIER
\t\twhere
\t\t\ts_comment like '%Customer%Complaints%'
\t)
group by
\tp_brand,
\tp_type,
\tp_size
order by
\tSUPPLIER_cnt desc,
\tp_brand,
\tp_type,
\tp_size
