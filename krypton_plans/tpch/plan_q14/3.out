  Sql Statement: EXPLAIN ANALYZE VERBOSE SELECT
\t100.00 * sum(case
\t\twhen p_type like 'PROMO%'
\t\t\tthen l_extendedprice * (1 - l_discount)
\t\telse 0
\tend) / sum(l_extendedprice * (1 - l_discount)) as promo_revenue
from
\tLINEITEM,
\tPART
where
\tl_partkey = p_partkey
\tand l_shipdate >= date '1993-10-01'
\tand l_shipdate < date '1993-10-01' + interval '1' month
