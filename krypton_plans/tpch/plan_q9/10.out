  User: root
  Default Db: default_cluster:tpch_1g_db
  Sql Statement: EXPLAIN ANALYZE VERBOSE SELECT
\tNATION,
\to_year,
\tsum(amount) as sum_profit
from
\t(
\t\tselect
\t\t\tn_name as nation,
\t\t\textract(year from o_orderdate) as o_year,
\t\t\tl_extendedprice * (1 - l_discount) - ps_supplycost * l_quantity as amount
\t\tfrom
\t\t\tPART,
\t\t\tSUPPLIER,
\t\t\tLINEITEM,
\t\t\tPARTSUPP,
\t\t\tORDERS,
\t\t\tNATION
\t\twhere
\t\t\ts_suppkey = l_suppkey
\t\t\tand ps_suppkey = l_suppkey
\t\t\tand ps_partkey = l_partkey
\t\t\tand p_partkey = l_partkey
\t\t\tand o_orderkey = l_orderkey
\t\t\tand s_nationkey = n_nationkey
\t\t\tand p_name like '%ghost%'
\t) as profit
group by
\tNATION,
\to_year
order by
\tNATION,
\to_year desc
