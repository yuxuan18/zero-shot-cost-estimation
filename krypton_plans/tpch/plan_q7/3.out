  User: root
  Default Db: default_cluster:tpch_1g_db
  Sql Statement: EXPLAIN ANALYZE VERBOSE SELECT
\tsupp_nation,
\tcust_nation,
\tl_year,
\tsum(volume) as revenue
from
\t(
\t\tselect
\t\t\tn1.n_name as supp_nation,
\t\t\tn2.n_name as cust_nation,
\t\t\textract(year from l_shipdate) as l_year,
\t\t\tl_extendedprice * (1 - l_discount) as volume
\t\tfrom
\t\t\tSUPPLIER,
\t\t\tLINEITEM,
\t\t\tORDERS,
\t\t\tCUSTOMER,
\t\t\tNATION n1,
\t\t\tNATION n2
\t\twhere
\t\t\ts_suppkey = l_suppkey
\t\t\tand o_orderkey = l_orderkey
\t\t\tand c_custkey = o_custkey
\t\t\tand s_nationkey = n1.n_nationkey
\t\t\tand c_nationkey = n2.n_nationkey
\t\t\tand (
\t\t\t\t(n1.n_name = 'ALGERIA' and n2.n_name = 'SAUDI ARABIA')
\t\t\t\tor (n1.n_name = 'SAUDI ARABIA' and n2.n_name = 'ALGERIA')
\t\t\t)
\t\t\tand l_shipdate between date '1995-01-01' and date '1996-12-31'
\t) as shipping
group by
\tsupp_nation,
\tcust_nation,
\tl_year
order by
\tsupp_nation,
\tcust_nation,
\tl_year
