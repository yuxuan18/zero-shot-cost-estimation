  Default Db: default_cluster:tpch_1g_db
  Sql Statement: EXPLAIN ANALYZE VERBOSE SELECT
\tsum(l_extendedprice* (1 - l_discount)) as revenue
from
\tLINEITEM,
\tPART
where
\t(
\t\tp_partkey = l_partkey
\t\tand p_brand = 'Brand#44'
\t\tand p_container in ('SM CASE', 'SM BOX', 'SM PACK', 'SM PKG')
\t\tand l_quantity >= 8 and l_quantity <= 8 + 10
\t\tand p_size between 1 and 5
\t\tand l_shipmode in ('AIR', 'AIR REG')
\t\tand l_shipinstruct = 'DELIVER IN PERSON'
\t)
\tor
\t(
\t\tp_partkey = l_partkey
\t\tand p_brand = 'Brand#12'
\t\tand p_container in ('MED BAG', 'MED BOX', 'MED PKG', 'MED PACK')
\t\tand l_quantity >= 19 and l_quantity <= 19 + 10
\t\tand p_size between 1 and 10
\t\tand l_shipmode in ('AIR', 'AIR REG')
\t\tand l_shipinstruct = 'DELIVER IN PERSON'
\t)
\tor
\t(
\t\tp_partkey = l_partkey
\t\tand p_brand = 'Brand#24'
\t\tand p_container in ('LG CASE', 'LG BOX', 'LG PACK', 'LG PKG')
\t\tand l_quantity >= 29 and l_quantity <= 29 + 10
\t\tand p_size between 1 and 15
\t\tand l_shipmode in ('AIR', 'AIR REG')
\t\tand l_shipinstruct = 'DELIVER IN PERSON'
\t)
