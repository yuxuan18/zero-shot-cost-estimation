  Total: 128ms
  Query Type: Query
  Query State: EOF
  User: root
  Default Db: default_cluster:tpch_1g_db
  Sql Statement: EXPLAIN ANALYZE VERBOSE SELECT
\to_year,
\tsum(case
\t\twhen nation = 'INDONESIA' then volume
\t\telse 0
\tend) / sum(volume) as mkt_share
from
\t(
\t\tselect
\t\t\textract(year from o_orderdate) as o_year,
\t\t\tl_extendedprice * (1 - l_discount) as volume,
\t\t\tn2.n_name as nation
\t\tfrom
\t\t\tPART,
\t\t\tSUPPLIER,
\t\t\tLINEITEM,
\t\t\tORDERS,
\t\t\tCUSTOMER,
\t\t\tNATION n1,
\t\t\tNATION n2,
\t\t\tREGION
\t\twhere
\t\t\tp_partkey = l_partkey
\t\t\tand s_suppkey = l_suppkey
\t\t\tand l_orderkey = o_orderkey
\t\t\tand o_custkey = c_custkey
\t\t\tand c_nationkey = n1.n_nationkey
\t\t\tand n1.n_regionkey = r_regionkey
\t\t\tand r_name = 'ASIA'
\t\t\tand s_nationkey = n2.n_nationkey
\t\t\tand o_orderdate between date '1995-01-01' and date '1996-12-31'
\t\t\tand p_type = 'ECONOMY ANODIZED NICKEL'
\t) as all_nations
group by
\to_year
order by
\to_year
