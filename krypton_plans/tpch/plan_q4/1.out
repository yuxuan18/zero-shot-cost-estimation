  Sql Statement: EXPLAIN ANALYZE VERBOSE SELECT
\to_orderpriority,
\tcount(*) as order_count
from
\tORDERS
where
\to_orderdate >= date '1995-07-01'
\tand o_orderdate < date '1995-07-01' + interval '3' month
\tand exists (
\t\tselect
\t\t\t*
\t\tfrom
\t\t\tLINEITEM
\t\twhere
\t\t\tl_orderkey = o_orderkey
\t\t\tand l_commitdate < l_receiptdate
\t)
group by
\to_orderpriority
order by
\to_orderpriority
