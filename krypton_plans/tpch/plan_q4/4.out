\t\tselect
\t\t\t*
\t\tfrom
\t\t\tLINEITEM
\t\twhere
\t\t\tl_orderkey = o_orderkey
\t\t\tand l_commitdate < l_receiptdate
\t)
group by
\to_orderpriority
order by
\to_orderpriority
