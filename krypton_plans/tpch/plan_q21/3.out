  Default Db: default_cluster:tpch_1g_db
  Sql Statement: EXPLAIN ANALYZE VERBOSE SELECT
\ts_name,
\tcount(*) as numwait
from
\tSUPPLIER,
\tLINEITEM l1,
\tORDERS,
\tNATION
where
\ts_suppkey = l1.l_suppkey
\tand o_orderkey = l1.l_orderkey
\tand o_orderstatus = 'F'
\tand l1.l_receiptdate > l1.l_commitdate
\tand exists (
\t\tselect
\t\t\t*
\t\tfrom
\t\t\tLINEITEM l2
\t\twhere
\t\t\tl2.l_orderkey = l1.l_orderkey
\t\t\tand l2.l_suppkey <> l1.l_suppkey
\t)
\tand not exists (
\t\tselect
\t\t\t*
\t\tfrom
\t\t\tLINEITEM l3
\t\twhere
\t\t\tl3.l_orderkey = l1.l_orderkey
\t\t\tand l3.l_suppkey <> l1.l_suppkey
\t\t\tand l3.l_receiptdate > l3.l_commitdate
\t)
\tand s_nationkey = n_nationkey
\tand n_name = 'ARGENTINA'
group by
\ts_name
order by
\tnumwait desc,
\ts_name
