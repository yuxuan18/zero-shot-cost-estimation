  Default Db: default_cluster:tpch_1g_db
  Sql Statement: EXPLAIN ANALYZE VERBOSE SELECT
\tl_shipmode,
\tsum(case
\t\twhen o_orderpriority = '1-URGENT'
\t\t\tor o_orderpriority = '2-HIGH'
\t\t\tthen 1
\t\telse 0
\tend) as high_line_count,
\tsum(case
\t\twhen o_orderpriority <> '1-URGENT'
\t\t\tand o_orderpriority <> '2-HIGH'
\t\t\tthen 1
\t\telse 0
\tend) as low_line_count
from
\tORDERS,
\tLINEITEM
where
\to_orderkey = l_orderkey
\tand l_shipmode in ('MAIL', 'REG AIR')
\tand l_commitdate < l_receiptdate
\tand l_shipdate < l_commitdate
\tand l_receiptdate >= date '1993-01-01'
\tand l_receiptdate < date '1993-01-01' + interval '1' year
group by
\tl_shipmode
order by
\tl_shipmode
