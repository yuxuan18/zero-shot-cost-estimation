  Sql Statement: EXPLAIN ANALYZE VERBOSE SELECT
\tcntrycode,
\tcount(*) as numcust,
\tsum(c_acctbal) as totacctbal
from
\t(
\t\tselect
\t\t\tsubstring(c_phone, 1, 2) as cntrycode,
\t\t\tc_acctbal
\t\tfrom
\t\t\tCUSTOMER
\t\twhere
\t\t\tsubstring(c_phone, 1, 2) in
\t\t\t\t('17', '19', '26', '29', '31', '32', '30')
\t\t\tand c_acctbal > (
\t\t\t\tselect
\t\t\t\t\tavg(c_acctbal)
\t\t\t\tfrom
\t\t\t\t\tCUSTOMER
\t\t\t\twhere
\t\t\t\t\tc_acctbal > 0.00
\t\t\t\t\tand substring(c_phone, 1, 2) in
\t\t\t\t\t\t('17', '19', '26', '29', '31', '32', '30')
\t\t\t)
\t\t\tand not exists (
\t\t\t\tselect
\t\t\t\t\t*
\t\t\t\tfrom
\t\t\t\t\tORDERS
\t\t\t\twhere
\t\t\t\t\to_custkey = c_custkey
\t\t\t)
\t) as custsale
group by
\tcntrycode
order by
