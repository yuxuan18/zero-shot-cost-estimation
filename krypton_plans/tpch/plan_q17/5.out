  Sql Statement: EXPLAIN ANALYZE VERBOSE SELECT
\tsum(l_extendedprice) / 7.0 as avg_yearly
from
\tLINEITEM,
\tPART
where
\tp_partkey = l_partkey
\tand p_brand = 'Brand#15'
\tand p_container = 'LG PKG'
\tand l_quantity < (
\t\tselect
\t\t\t0.2 * avg(l_quantity)
\t\tfrom
\t\t\tLINEITEM
\t\twhere
\t\t\tl_partkey = p_partkey
\t)
