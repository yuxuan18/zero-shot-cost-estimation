\tp_partkey = l_partkey
\tand p_brand = 'Brand#14'
\tand p_container = 'MED BAG'
\tand l_quantity < (
\t\tselect
\t\t\t0.2 * avg(l_quantity)
\t\tfrom
\t\t\tLINEITEM
\t\twhere
\t\t\tl_partkey = p_partkey
\t)
