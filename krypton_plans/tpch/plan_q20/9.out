  Sql Statement: EXPLAIN ANALYZE VERBOSE SELECT
\ts_name,
\ts_address
from
\tSUPPLIER,
\tNATION
where
\ts_suppkey in (
\t\tselect
\t\t\tps_suppkey
\t\tfrom
\t\t\tPARTSUPP
\t\twhere
\t\t\tps_partkey in (
\t\t\t\tselect
\t\t\t\t\tp_partkey
\t\t\t\tfrom
\t\t\t\t\tPART
\t\t\t\twhere
\t\t\t\t\tp_name like 'red%'
\t\t\t)
\t\t\tand ps_availqty > (
\t\t\t\tselect
\t\t\t\t\t0.5 * sum(l_quantity)
\t\t\t\tfrom
\t\t\t\t\tLINEITEM
\t\t\t\twhere
\t\t\t\t\tl_partkey = ps_partkey
\t\t\t\t\tand l_suppkey = ps_suppkey
\t\t\t\t\tand l_shipdate >= date '1993-01-01'
\t\t\t\t\tand l_shipdate < date '1993-01-01' + interval '1' year
\t\t\t)
\t)
\tand s_nationkey = n_nationkey
\tand n_name = 'GERMANY'
order by
\ts_name
