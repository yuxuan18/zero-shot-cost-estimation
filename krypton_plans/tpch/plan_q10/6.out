  Sql Statement: EXPLAIN ANALYZE VERBOSE SELECT
\tc_custkey,
\tc_name,
\tsum(l_extendedprice * (1 - l_discount)) as revenue,
\tc_acctbal,
\tn_name,
\tc_address,
\tc_phone,
\tc_comment
from
\tCUSTOMER,
\tORDERS,
\tLINEITEM,
\tNATION
where
\tc_custkey = o_custkey
