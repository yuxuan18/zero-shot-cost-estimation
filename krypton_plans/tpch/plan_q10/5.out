  Sql Statement: EXPLAIN ANALYZE VERBOSE SELECT
\tc_custkey,
\tc_name,
\tsum(l_extendedprice * (1 - l_discount)) as revenue,
\tc_acctbal,
\tn_name,
\tc_address,
\tc_phone,
\tc_comment
from
\tCUSTOMER,
\tORDERS,
\tLINEITEM,
\tNATION
where
\tc_custkey = o_custkey
\tand l_orderkey = o_orderkey
\tand o_orderdate >= date '1994-12-01'
\tand o_orderdate < date '1994-12-01' + interval '3' month
\tand l_returnflag = 'R'
\tand c_nationkey = n_nationkey
group by
\tc_custkey,
\tc_name,
\tc_acctbal,
\tc_phone,
\tn_name,
\tc_address,
\tc_comment
order by
\trevenue desc
