\tand o_orderdate >= date '1993-03-01'
\tand o_orderdate < date '1993-03-01' + interval '3' month
\tand l_returnflag = 'R'
\tand c_nationkey = n_nationkey
group by
\tc_custkey,
\tc_name,
\tc_acctbal,
\tc_phone,
\tn_name,
\tc_address,
\tc_comment
order by
\trevenue desc
