  Sql Statement: EXPLAIN ANALYZE VERBOSE SELECT
\tl_orderkey,
\tsum(l_extendedprice * (1 - l_discount)) as revenue,
\to_orderdate,
\to_shippriority
from
\tCUSTOMER,
\tORDERS,
\tLINEITEM
where
\tc_mktsegment = 'HOUSEHOLD'
\tand c_custkey = o_custkey
\tand l_orderkey = o_orderkey
\tand o_orderdate < date '1995-03-07'
\tand l_shipdate > date '1995-03-07'
group by
\tl_orderkey,
\to_orderdate,
\to_shippriority
order by
\trevenue desc,
\to_orderdate
