  Sql Statement: EXPLAIN ANALYZE VERBOSE SELECT
\tl_orderkey,
\tsum(l_extendedprice * (1 - l_discount)) as revenue,
\to_orderdate,
\to_shippriority
from
\tCUSTOMER,
\tORDERS,
\tLINEITEM
where
\tc_mktsegment = 'FURNITURE'
