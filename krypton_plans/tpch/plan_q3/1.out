\tand l_orderkey = o_orderkey
\tand o_orderdate < date '1995-03-17'
\tand l_shipdate > date '1995-03-17'
group by
\tl_orderkey,
\to_orderdate,
\to_shippriority
order by
\trevenue desc,
\to_orderdate
