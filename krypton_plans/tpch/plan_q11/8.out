  Sql Statement: EXPLAIN ANALYZE VERBOSE SELECT
\tps_partkey,
\tsum(ps_supplycost * ps_availqty) as value
from
\tPARTSUPP,
\tSUPPLIER,
\tNATION
where
\tps_suppkey = s_suppkey
\tand s_nationkey = n_nationkey
\tand n_name = 'CANADA'
group by
